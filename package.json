{
  "name": "tracktool",
  "version": "2.0.0-rc.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "packageManager": "pnpm@12.10.1",
  "bin": {
    "tracktool": "dist/node/cli/main.js",
    "tracktool-map": "dist/node/server/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/*.md",
    "docs/history",
    "docs/validation",
    "docs/*.json"
  ],
  "scripts": {
    "build": "node scripts/build-maps.ts --clean && tsc -p tsconfig.build.json && vite build && node scripts/build-maps.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src tests/ts tests/e2e *.ts scripts/*.ts && depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write src tests/ts tests/e2e *.ts scripts/*.ts scripts/release/*.mjs package.json tsconfig*.json .dependency-cruiser.cjs eslint.config.js",
    "format:check": "prettier --check src tests/ts tests/e2e *.ts scripts/*.ts scripts/release/*.mjs package.json tsconfig*.json .dependency-cruiser.cjs eslint.config.js",
    "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "start": "node dist/node/server/main.js",
    "dev": "pnpm build && node scripts/dev.ts",
    "cli": "node dist/node/cli/main.js",
    "cities": "node scripts/build-map-cities.ts",
    "verify:package": "node scripts/release/verify-package.mjs",
    "test:terminal": "node scripts/release/terminal.mjs"
  },
  "oclif": {
    "bin": "tracktool",
    "topicSeparator": " ",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/node/cli/commands.js",
      "identifier": "COMMANDS"
    },
    "plugins": [
      "@oclif/plugin-autocomplete"
    ]
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@foxglove/wasm-bz2": "0.3.0",
    "@napi-rs/lzma": "1.5.1",
    "@oclif/core": "5.1.7",
    "@oclif/plugin-autocomplete": "4.0.4",
    "@tanstack/react-query": "5.104.2",
    "@zip.js/zip.js": "2.23.0",
    "antd": "6.6.6",
    "better-sqlite3": "13.0.3",
    "exiftool-vendored": "39.0.1",
    "fastify": "5.12.7",
    "gcoord": "1.0.7",
    "geographiclib-geodesic": "2.2.0",
    "geojson-vt": "4.0.3",
    "ink": "8.0.0",
    "libxml2-wasm": "0.7.2",
    "maplibre-gl": "5.6.1",
    "opentype.js": "2.0.0",
    "playwright": "1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sharp": "0.35.5",
    "vt-pbf": "3.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "description": "KML 轨迹归档、地图与照片/视频地理数据工具",
  "exports": {
    ".": {
      "types": "./dist/node/api.d.ts",
      "import": "./dist/node/api.js"
    }
  }
}

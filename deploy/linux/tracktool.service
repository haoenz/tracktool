[Unit]
Description=Tracktool map and archive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tracktool
Group=tracktool
WorkingDirectory=/var/lib/tracktool/data
Environment=NODE_ENV=production
Environment=PATH=/var/lib/tracktool/.nvm/versions/node/v26.11.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_STATE_HOME=/var/lib/tracktool/state
Environment=XDG_CACHE_HOME=/var/cache/tracktool
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/cache/tracktool/browsers
EnvironmentFile=/etc/tracktool/service.env
ExecStart=/opt/tracktool/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tracktool/data /var/lib/tracktool/state /var/cache/tracktool

[Install]
WantedBy=multi-user.target
